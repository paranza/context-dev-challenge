CONTEXT_DEV_API_KEY=replace_with_your_context_dev_key
# Set a stable random secret so saved monitor links survive Context.dev key rotation.
# If omitted, monitor links are signed with CONTEXT_DEV_API_KEY.
# MONITOR_TOKEN_SECRET=replace_with_a_long_random_secret
# Set this to the public HTTPS app URL to enable unattended monitor expiry.
# APP_BASE_URL=https://your-deployed-app.example
